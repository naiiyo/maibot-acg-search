{
  "manifest_version": 2,
  "id": "naiiyo.acg-search",
  "version": "0.1.0",
  "name": "二次元特化搜索",
  "description": "五源核验 Galgame 作品和发行版本，查询番剧放送、漫画与二游资料，并按需调用原生或自定义网页搜索。",
  "author": {"name": "Codex", "url": "https://openai.com/codex/"},
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/naiiyo/maibot-acg-search",
    "documentation": "https://github.com/naiiyo/maibot-acg-search#readme",
    "issues": "https://github.com/naiiyo/maibot-acg-search/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {"min_version": "1.4.3", "max_version": "1.4.3"},
  "sdk": {"min_version": "2.22.1", "max_version": "2.22.1"},
  "dependencies": [{"type": "python_package", "name": "httpx", "version_spec": ">=0.27,<1"}],
  "capabilities": ["web.search", "web.fetch", "send.text"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "plugin_type": "tool"
}
